# ==============================================================================
# web-hrms — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# NextAuth.js v5
# ------------------------------------------------------------------------------
# AUTH_SECRET: Generate with: npx auth secret (or openssl rand -base64 32)
# AUTH_URL: The canonical URL of this app (must match OIDC redirect URI)
# AUTH_SECRET=
# AUTH_URL=https://localhost:3001

# ------------------------------------------------------------------------------
# OIDC Provider (internal-auth-service)
# ------------------------------------------------------------------------------
# Source: internal-auth-service seeder (DbSeeder.cs)
# Client registered as "hrms-client" with redirect to https://localhost:3001
# AUTH_HRMS_CLIENT_ID=hrms-client
# AUTH_HRMS_CLIENT_SECRET=hrms-secret
# AUTH_ISSUER=https://localhost:5001/

# ------------------------------------------------------------------------------
# API Backend Services
# ------------------------------------------------------------------------------
# HRMS API (.NET) — used by server components and the /api/hrms proxy route
NEXT_PUBLIC_HRMS_API_URL=https://localhost:5165

# ------------------------------------------------------------------------------
# Sibling systems (portal / cross-app navigation)
# Ports mirror internal-auth-service SystemDefinition seed (DbSeeder.cs)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_HOST_URL=https://localhost:3000
NEXT_PUBLIC_HRMS_URL=https://localhost:3001
NEXT_PUBLIC_POS_URL=https://localhost:3002
NEXT_PUBLIC_SCMS_URL=https://localhost:3003
NEXT_PUBLIC_OOS_URL=https://localhost:3004
NEXT_PUBLIC_CRMS_URL=https://localhost:3005
